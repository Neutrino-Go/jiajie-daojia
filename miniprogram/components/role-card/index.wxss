.role-card {
  display: flex;
  align-items: center;
  gap: 20rpx;
  min-height: 150rpx;
  padding: 26rpx;
  border-radius: 26rpx;
  background: #fff;
  text-align: left;
}

.icon {
  display: flex;
  flex: 0 0 76rpx;
  align-items: center;
  justify-content: center;
  width: 76rpx;
  height: 76rpx;
  border-radius: 22rpx;
  background: #16a05d;
  color: #fff;
  font-weight: 900;
}

.orange .icon {
  background: #ff8d1a;
}

.title {
  color: #17231d;
  font-size: 30rpx;
  font-weight: 900;
}

.desc {
  margin-top: 8rpx;
  color: #7a8580;
  font-size: 24rpx;
}
