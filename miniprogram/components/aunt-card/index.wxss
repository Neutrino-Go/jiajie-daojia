.aunt-card {
  display: flex;
  gap: 20rpx;
  width: 100%;
  padding: 24rpx;
  border-radius: 22rpx;
  background: #fff;
  box-shadow: 0 10rpx 26rpx rgba(28, 76, 51, 0.05);
}

.avatar {
  display: flex;
  flex: 0 0 86rpx;
  align-items: center;
  justify-content: center;
  width: 86rpx;
  height: 86rpx;
  border-radius: 50%;
  background: #e9fbf1;
  color: #14a45d;
  font-size: 34rpx;
  font-weight: 900;
  overflow: hidden;
}

.avatar-img {
  display: block;
  width: 100%;
  height: 100%;
}

.body {
  flex: 1;
  min-width: 0;
}

.row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12rpx;
}

.name {
  flex: 1;
  min-width: 0;
  color: #14231b;
  font-size: 30rpx;
  font-weight: 900;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.distance,
.area {
  color: #8c9691;
  font-size: 23rpx;
}

.distance {
  flex: 0 0 auto;
  font-weight: 800;
}

.rating {
  margin-top: 6rpx;
  color: #ff8a18;
  font-size: 24rpx;
  font-weight: 800;
}

.area {
  margin-top: 6rpx;
}

.tags {
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx;
  margin-top: 10rpx;
}

.tag {
  padding: 5rpx 12rpx;
  border-radius: 8rpx;
  background: #ecfbf2;
  color: #14995a;
  font-size: 21rpx;
}
