.hero-card {
  display: flex;
  align-items: center;
  justify-content: space-between;
  min-height: 188rpx;
  padding: 34rpx;
  overflow: hidden;
  border-radius: 28rpx;
  background: linear-gradient(135deg, #1fbf70, #07924e);
  color: #fff;
}

.hero-card.orange {
  background: linear-gradient(135deg, #ff9c2b, #f17812);
}

.hero-title {
  font-size: 40rpx;
  font-weight: 900;
}

.hero-subtitle {
  margin-top: 12rpx;
  font-size: 25rpx;
}

.hero-image {
  flex: 0 0 160rpx;
  width: 160rpx;
  height: 130rpx;
}
