.address-page {
  padding-bottom: 160rpx;
}

.address-list {
  display: grid;
  gap: 18rpx;
  margin-top: 24rpx;
}

.address-card {
  padding: 28rpx;
  border-radius: 18rpx;
  background: #fff;
  box-shadow: 0 10rpx 30rpx rgba(29, 80, 52, 0.06);
}

.card-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}

.community {
  min-width: 0;
  color: #17231d;
  font-size: 32rpx;
  font-weight: 900;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.default-tag {
  flex: 0 0 auto;
  padding: 6rpx 14rpx;
  border-radius: 999rpx;
  background: #e8f8ef;
  color: #14995a;
  font-size: 22rpx;
  font-weight: 900;
}

.area {
  margin-top: 14rpx;
  color: #58655f;
  font-size: 25rpx;
  line-height: 1.45;
}

.detail {
  margin-top: 8rpx;
  color: #17231d;
  font-size: 28rpx;
  font-weight: 800;
  line-height: 1.45;
}

.actions {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
  margin-top: 22rpx;
}

.actions button {
  flex: 1 1 140rpx;
  min-width: 0;
  min-height: 64rpx;
  padding: 0 8rpx;
  border-radius: 12rpx;
  background: #f0f4f2;
  color: #58655f;
  font-size: 23rpx;
  font-weight: 900;
  line-height: 1.2;
}

.actions .primary {
  background: #16a05d;
  color: #fff;
}

.actions .danger {
  background: #fff0ed;
  color: #d93025;
}

.add-button {
  position: fixed;
  right: 32rpx;
  bottom: 42rpx;
  left: 32rpx;
  min-height: 88rpx;
  border-radius: 999rpx;
  background: #16a05d;
  color: #fff;
  font-size: 29rpx;
  font-weight: 900;
  box-shadow: 0 12rpx 28rpx rgba(22, 160, 93, 0.28);
}

.form-mask {
  position: fixed;
  inset: 0;
  z-index: 20;
  display: flex;
  align-items: flex-end;
  background: rgba(18, 30, 25, 0.45);
}

.form-panel {
  position: relative;
  width: 100%;
  max-height: 86vh;
  padding: 28rpx 32rpx 42rpx;
  border-radius: 28rpx 28rpx 0 0;
  background: #f7f8fa;
  box-sizing: border-box;
  overflow-y: auto;
}

.form-head {
  display: flex;
  align-items: center;
  justify-content: flex-start;
  padding-right: 76rpx;
  margin-bottom: 22rpx;
}

.form-title {
  color: #17231d;
  font-size: 32rpx;
  font-weight: 900;
}

.form-head .close-button {
  position: absolute;
  top: 28rpx;
  right: 32rpx;
  width: 58rpx;
  min-height: 58rpx;
  border-radius: 50%;
  background: #e7ece9;
  color: #58655f;
  font-size: 34rpx;
  font-weight: 700;
  line-height: 58rpx;
}

.field {
  margin-top: 16rpx;
  padding: 22rpx;
  border-radius: 18rpx;
  background: #fff;
}

.field-label {
  color: #7a8580;
  font-size: 23rpx;
  font-weight: 800;
}

.field input,
.picker-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  min-height: 62rpx;
  margin-top: 8rpx;
  color: #17231d;
  font-size: 28rpx;
  font-weight: 800;
}

.arrow {
  color: #9aa39f;
  font-size: 36rpx;
}

.default-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
  margin-top: 16rpx;
  padding: 22rpx;
  border-radius: 18rpx;
  background: #fff;
}

.default-title {
  color: #17231d;
  font-size: 28rpx;
  font-weight: 900;
}

.default-sub {
  margin-top: 6rpx;
  color: #8a9490;
  font-size: 22rpx;
}

.save-button {
  width: 100%;
  min-height: 84rpx;
  margin-top: 22rpx;
  border-radius: 999rpx;
  background: #16a05d;
  color: #fff;
  font-size: 28rpx;
  font-weight: 900;
}
