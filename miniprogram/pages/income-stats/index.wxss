.summary {
  padding: 34rpx;
  border-radius: 24rpx;
  background: linear-gradient(135deg, #ff9a24, #fb7e12);
  color: #fff;
}

.summary-label,
.summary-sub {
  opacity: 0.9;
  font-size: 24rpx;
}

.summary-value {
  margin-top: 12rpx;
  font-size: 54rpx;
  font-weight: 900;
}

.mini-card {
  padding: 24rpx;
  border-radius: 20rpx;
  background: #fff;
}

.mini-label {
  color: #7a8580;
  font-size: 24rpx;
}

.mini-value {
  margin-top: 10rpx;
  color: #17231d;
  font-size: 34rpx;
  font-weight: 900;
}

.bars {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  gap: 12rpx;
  height: 210rpx;
  margin-top: 24rpx;
}

.bar-item {
  display: flex;
  flex: 1;
  flex-direction: column;
  align-items: center;
  justify-content: flex-end;
}

.bar {
  width: 32rpx;
  border-radius: 999rpx 999rpx 0 0;
  background: #26b76d;
}

.bar-amount {
  margin-bottom: 8rpx;
  color: #405049;
  font-size: 20rpx;
  font-weight: 800;
  line-height: 1;
}

.bar-label {
  margin-top: 10rpx;
  color: #89918d;
  font-size: 20rpx;
}

.income-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #f0f3f1;
}

.income-title {
  color: #17231d;
  font-weight: 900;
}

.income-sub {
  margin-top: 6rpx;
  color: #7a8580;
  font-size: 23rpx;
}

.income-price {
  color: #ff7f16;
  font-weight: 900;
}
