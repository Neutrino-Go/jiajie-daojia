.page {
  min-height: 100vh;
  padding: 24rpx;
  background: #f7f8fa;
  box-sizing: border-box;
}
.section-title {
  font-size: 36rpx;
  font-weight: 700;
  margin: 12rpx 0 20rpx;
  color: #18211d;
}
.notice,
.form-card {
  background: #ffffff;
  border-radius: 12rpx;
  padding: 24rpx;
  margin-bottom: 20rpx;
}
.notice {
  color: #5b6862;
  font-size: 26rpx;
  line-height: 1.7;
}
.field {
  margin-bottom: 24rpx;
}
.label {
  font-size: 26rpx;
  color: #4d5a54;
  margin-bottom: 10rpx;
}
.picker,
.input,
.textarea {
  width: 100%;
  background: #f7f8fa;
  border-radius: 8rpx;
  padding: 18rpx;
  box-sizing: border-box;
  font-size: 28rpx;
  color: #18211d;
}
.textarea {
  min-height: 180rpx;
}
.textarea.small {
  min-height: 120rpx;
}
.primary {
  background: #16a05d;
  color: #ffffff;
  border-radius: 8rpx;
}
