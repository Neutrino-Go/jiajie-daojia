.page {
  min-height: 100vh;
  background: #f7f8fa;
  padding: 24rpx;
  box-sizing: border-box;
}

.card {
  background: #fff;
  border-radius: 8rpx;
  padding: 24rpx;
}

.label {
  margin: 20rpx 0 12rpx;
  color: #4b5563;
  font-size: 26rpx;
}

.picker,
.input,
.textarea {
  width: 100%;
  background: #f4f6f5;
  border-radius: 8rpx;
  padding: 20rpx;
  box-sizing: border-box;
  font-size: 28rpx;
}

.textarea {
  min-height: 180rpx;
}

.images {
  display: flex;
  gap: 16rpx;
  flex-wrap: wrap;
}

.image-item,
.image-add {
  width: 144rpx;
  height: 144rpx;
  border-radius: 8rpx;
  background: #f4f6f5;
  overflow: hidden;
  position: relative;
}

.image-item image {
  width: 100%;
  height: 100%;
}

.image-add {
  display: flex;
  align-items: center;
  justify-content: center;
  color: #16a05d;
  font-size: 48rpx;
}

.remove {
  position: absolute;
  top: 6rpx;
  right: 6rpx;
  width: 36rpx;
  height: 36rpx;
  line-height: 36rpx;
  text-align: center;
  border-radius: 50%;
  background: rgba(0, 0, 0, 0.55);
  color: #fff;
}

.submit {
  margin-top: 24rpx;
  background: #16a05d;
  color: #fff;
  border-radius: 8rpx;
}
