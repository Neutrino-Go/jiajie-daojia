.profile-page {
  min-height: 100vh;
  padding: 24rpx 24rpx 54rpx;
  background: #f5f7f6;
}

.brand-card {
  position: relative;
  min-height: 268rpx;
  padding: 32rpx;
  overflow: hidden;
  border-radius: 36rpx;
  background: linear-gradient(135deg, #17b95c, #22c76e);
  box-shadow: 0 12rpx 30rpx rgba(20, 150, 90, 0.12);
}

.cleaner .brand-card {
  background: linear-gradient(135deg, #17b95c, #20bf66);
}

.brand-card::before {
  position: absolute;
  top: -88rpx;
  right: -56rpx;
  width: 250rpx;
  height: 250rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.07);
  content: "";
}

.brand-card::after {
  position: absolute;
  right: 34rpx;
  bottom: -98rpx;
  width: 210rpx;
  height: 210rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.04);
  content: "";
}

.brand-content {
  position: relative;
  z-index: 1;
  display: flex;
  align-items: center;
  gap: 26rpx;
  min-width: 0;
  min-height: 204rpx;
  padding-right: 88rpx;
}

.profile-avatar {
  display: flex;
  flex: 0 0 100rpx;
  align-items: center;
  justify-content: center;
  width: 100rpx;
  height: 100rpx;
  border: 4rpx solid rgba(255, 255, 255, 0.55);
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.24);
  color: #fff;
  font-size: 40rpx;
  font-weight: 800;
  overflow: hidden;
}

.profile-avatar image {
  display: block;
  width: 100%;
  height: 100%;
}

.profile-main {
  flex: 1;
  min-width: 0;
}

.edit-profile-btn {
  position: absolute;
  top: 28rpx;
  right: 28rpx;
  z-index: 3;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.16);
}

.edit-pencil {
  position: relative;
  width: 30rpx;
  height: 30rpx;
}

.edit-pencil::before {
  position: absolute;
  top: 13rpx;
  left: 4rpx;
  width: 24rpx;
  height: 6rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.88);
  transform: rotate(-42deg);
  content: "";
}

.edit-pencil::after {
  position: absolute;
  right: 1rpx;
  bottom: 4rpx;
  width: 9rpx;
  height: 9rpx;
  border-right: 4rpx solid rgba(255, 255, 255, 0.88);
  border-bottom: 4rpx solid rgba(255, 255, 255, 0.88);
  transform: rotate(-42deg);
  content: "";
}

.profile-name {
  max-width: 360rpx;
  min-width: 0;
  color: #fff;
  font-size: 40rpx;
  font-weight: 800;
  line-height: 1.15;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.profile-phone {
  margin-top: 10rpx;
  color: rgba(255, 255, 255, 0.72);
  font-size: 25rpx;
  font-weight: 600;
}

.community-block {
  margin-top: 24rpx;
}

.community-pill {
  display: inline-flex;
  align-items: center;
  gap: 10rpx;
  max-width: 320rpx;
  min-height: 48rpx;
  padding: 8rpx 18rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.18);
  color: #fff;
  font-size: 25rpx;
  font-weight: 700;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.community-pin {
  position: relative;
  flex: 0 0 22rpx;
  width: 22rpx;
  height: 22rpx;
}

.community-pin::before {
  position: absolute;
  top: 1rpx;
  left: 50%;
  width: 18rpx;
  height: 18rpx;
  border-radius: 50% 50% 50% 0;
  background: #fff;
  transform: translateX(-50%) rotate(-45deg);
  content: "";
}

.community-pin::after {
  position: absolute;
  top: 6rpx;
  left: 50%;
  width: 6rpx;
  height: 6rpx;
  border-radius: 50%;
  background: #22c76e;
  transform: translateX(-50%);
  content: "";
}

.status-dot {
  flex: 0 0 12rpx;
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: #fff;
}

.brand-watermark {
  position: absolute;
  z-index: 1;
  right: -72rpx;
  bottom: -86rpx;
  width: 252rpx;
  height: 252rpx;
  opacity: 0.16;
}

.switch-wrap {
  position: absolute;
  z-index: 2;
  right: 32rpx;
  bottom: 32rpx;
}

.shortcut-card {
  display: grid;
  grid-template-columns: repeat(4, minmax(0, 1fr));
  gap: 14rpx;
  margin-top: 24rpx;
}

.shortcut {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 14rpx;
  min-width: 0;
  min-height: 146rpx;
  padding: 24rpx 8rpx;
  border-radius: 28rpx;
  background: #fff;
  box-shadow: 0 6rpx 18rpx rgba(0, 0, 0, 0.05);
}

.shortcut-hover,
.menu-row-hover {
  background: #f7faf8;
}

.shortcut-icon {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 60rpx;
  height: 60rpx;
  border-radius: 20rpx;
}

.icon-img {
  display: block;
  width: 34rpx;
  height: 34rpx;
}

.icon-green {
  background: rgba(22, 160, 93, 0.1);
  color: #16a05d;
}

.icon-orange {
  background: rgba(241, 120, 18, 0.1);
  color: #f17812;
}

.icon-star-bg {
  background: rgba(245, 164, 0, 0.1);
}

.icon-teal {
  background: rgba(22, 136, 168, 0.1);
  color: #1688a8;
}

.icon-blue {
  background: rgba(47, 139, 255, 0.1);
}

.icon-gold {
  background: rgba(233, 162, 0, 0.1);
  color: #e9a200;
}

.icon-coupon-bg {
  background: rgba(255, 138, 0, 0.1);
}

.shortcut-label {
  width: 100%;
  color: #13231d;
  font-size: 23rpx;
  font-weight: 700;
  line-height: 1.2;
  text-align: center;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.asset-card {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  margin-top: 24rpx;
  padding: 30rpx 18rpx;
  border-radius: 28rpx;
  background: #fff;
  box-shadow: 0 10rpx 28rpx rgba(29, 80, 52, 0.05);
}

.community-record-stats {
  margin-top: 0;
}

.asset-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  min-width: 0;
}

.asset-item + .asset-item {
  border-left: 1rpx solid rgba(0, 0, 0, 0.05);
}

.asset-value {
  color: #16a05d;
  font-size: 46rpx;
  font-weight: 800;
  line-height: 1.1;
}

.asset-label {
  margin-top: 8rpx;
  color: #6b7b73;
  font-size: 24rpx;
  font-weight: 600;
}

.section-title {
  margin: 32rpx 0 16rpx;
  color: #13231d;
  font-size: 32rpx;
  font-weight: 800;
}

.service-card {
  overflow: hidden;
  border-radius: 28rpx;
  background: #fff;
  box-shadow: 0 8rpx 22rpx rgba(0, 0, 0, 0.04);
}

.menu-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  min-height: 98rpx;
  padding: 0 28rpx;
  border-bottom: 1rpx solid rgba(0, 0, 0, 0.05);
}

.menu-row:last-child {
  border-bottom: 0;
}

.menu-left {
  display: flex;
  flex: 1;
  align-items: center;
  gap: 20rpx;
  min-width: 0;
}

.menu-icon {
  display: flex;
  flex: 0 0 52rpx;
  align-items: center;
  justify-content: center;
  width: 52rpx;
  height: 52rpx;
  border-radius: 18rpx;
  background: rgba(22, 160, 93, 0.1);
  color: #16a05d;
}

.menu-icon-gray {
  background: rgba(57, 66, 78, 0.1);
}

.menu-icon-img {
  display: block;
  width: 30rpx;
  height: 30rpx;
}

.menu-text {
  color: #13231d;
  font-size: 28rpx;
  font-weight: 600;
}

.chevron {
  flex: 0 0 auto;
  color: #a3aca7;
  font-size: 42rpx;
  font-weight: 300;
  line-height: 1;
}

.record-title {
  margin: 28rpx 0 14rpx;
}

.profile-edit-mask {
  position: fixed;
  inset: 0;
  z-index: 40;
  display: flex;
  align-items: flex-end;
  background: rgba(18, 30, 25, 0.45);
}

.profile-edit-panel {
  width: 100%;
  padding: 34rpx 32rpx 46rpx;
  border-radius: 30rpx 30rpx 0 0;
  background: #f7f8fa;
  box-sizing: border-box;
}

.profile-edit-title {
  color: #13231d;
  font-size: 32rpx;
  font-weight: 900;
}

.edit-avatar {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 112rpx;
  height: 112rpx;
  margin: 28rpx auto 10rpx;
  overflow: hidden;
  border-radius: 50%;
  background: #e8f8ef;
  color: #16a05d;
  font-size: 40rpx;
  font-weight: 900;
}

.edit-avatar image {
  display: block;
  width: 100%;
  height: 100%;
}

.edit-field {
  margin-top: 18rpx;
  padding: 20rpx 22rpx;
  border-radius: 18rpx;
  background: #fff;
}

.edit-label {
  color: #6b7b73;
  font-size: 24rpx;
  font-weight: 800;
}

.edit-field input {
  min-height: 62rpx;
  margin-top: 8rpx;
  color: #13231d;
  font-size: 28rpx;
  font-weight: 700;
}

.edit-actions {
  display: flex;
  gap: 16rpx;
  margin-top: 24rpx;
}

.edit-actions button {
  flex: 1;
  min-height: 82rpx;
  border-radius: 999rpx;
  font-size: 28rpx;
  font-weight: 900;
}

.edit-cancel {
  background: #eef3f0;
  color: #6b7b73;
}

.edit-save {
  background: #16a05d;
  color: #fff;
}
