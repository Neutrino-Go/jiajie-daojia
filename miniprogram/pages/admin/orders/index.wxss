.page { min-height: 100vh; padding: 32rpx; background: #f7f8fa; color: #1f2a24; }
.title { font-size: 34rpx; font-weight: 700; }
.hint { margin: 8rpx 0 24rpx; color: #6f7a74; font-size: 24rpx; }
.item { margin-bottom: 16rpx; padding: 20rpx; border-radius: 8rpx; background: #fff; }
.item text { display: block; margin-top: 8rpx; color: #6f7a74; font-size: 24rpx; }
.error { color: #c0392b; font-size: 24rpx; }
