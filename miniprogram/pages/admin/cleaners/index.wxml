<view class="page">
  <view class="title">家洁师准入</view>
  <view class="hint">此处仅查看审核队列；审核动作通过云函数 adminReviewCleanerVerification 执行。</view>
  <view wx:for="{{verifications}}" wx:key="verificationId" class="item">
    <view>{{item.cleanerId}}</view>
    <text>{{item.status}} / {{item.updatedAt}}</text>
  </view>
  <view wx:if="{{error}}" class="error">{{error}}</view>
</view>
