.page {
  min-height: 100vh;
  padding: 24rpx;
  background: #f7f8fa;
  box-sizing: border-box;
}
.card,
.empty {
  background: #ffffff;
  border-radius: 12rpx;
  padding: 24rpx;
  margin-bottom: 20rpx;
}
.title {
  font-size: 32rpx;
  font-weight: 700;
  color: #18211d;
}
.meta,
.desc,
.notice,
.empty {
  margin-top: 10rpx;
  font-size: 26rpx;
  color: #5b6862;
  line-height: 1.6;
}
.notice {
  color: #8a5a00;
}
