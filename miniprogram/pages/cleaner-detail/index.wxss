.profile-head {
  padding: 42rpx 30rpx;
  border-radius: 24rpx;
  background: linear-gradient(135deg, #1dbf70, #0a944e);
  color: #fff;
  text-align: center;
}

.avatar-wrap {
  position: relative;
  width: 120rpx;
  height: 120rpx;
  margin: 0 auto;
  border-radius: 50%;
  overflow: hidden;
}

.avatar,
.avatar-img {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.22);
  color: #fff;
  font-size: 44rpx;
  font-weight: 900;
}

.avatar-img {
  display: block;
  box-sizing: border-box;
  border: 4rpx solid rgba(255, 255, 255, 0.88);
  object-fit: cover;
}

.name {
  margin-top: 18rpx;
  font-size: 40rpx;
  font-weight: 900;
}

.rating {
  margin-top: 8rpx;
  color: #fff4cf;
  font-weight: 800;
}

.verify,
.text {
  margin-top: 12rpx;
  line-height: 1.6;
}

.verify {
  color: rgba(255, 255, 255, 0.88);
}

.text {
  color: #6f7b75;
}

.glass-card {
  padding: 28rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.72);
  border-radius: 24rpx;
  background: rgba(255, 255, 255, 0.86);
  box-shadow: 0 16rpx 40rpx rgba(29, 80, 52, 0.08);
}

.group-title {
  margin-top: 28rpx;
}

.ios-select {
  display: flex;
  flex-wrap: wrap;
  gap: 14rpx;
  margin-top: 18rpx;
  padding: 14rpx;
  border: 1rpx solid #e8eee9;
  border-radius: 22rpx;
  background: linear-gradient(180deg, #ffffff, #f7faf8);
}

.area-input-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-top: 18rpx;
}

.area-input-row .area-input {
  flex: 1;
  min-width: 0;
  margin-top: 0;
}

.area-add {
  flex: 0 0 126rpx;
  min-height: 78rpx;
  border-radius: 20rpx;
  background: #16a05d;
  color: #fff;
  font-size: 25rpx;
  font-weight: 900;
}

.area-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: 16rpx;
}

.area-empty {
  margin-top: 14rpx;
  color: #8a9490;
  font-size: 24rpx;
}

.ios-chip {
  min-height: 66rpx;
  padding: 0 22rpx;
  border: 1rpx solid #dfe8e2;
  border-radius: 999rpx;
  background: #fff;
  color: #55635c;
  font-size: 25rpx;
  font-weight: 800;
  box-shadow: inset 0 -2rpx 0 rgba(0, 0, 0, 0.03);
}

.ios-chip.active {
  border-color: #15a35f;
  background: linear-gradient(180deg, #eafff2, #dff8eb);
  color: #0a944e;
}

.ios-input {
  width: 100%;
  min-height: 84rpx;
  margin-top: 16rpx;
  padding: 0 24rpx;
  border: 1rpx solid #e1e9e4;
  border-radius: 20rpx;
  background: #fff;
  color: #17231d;
  font-size: 27rpx;
}

.save-btn {
  margin-top: 24rpx;
}

.info-row {
  display: flex;
  justify-content: space-between;
  gap: 24rpx;
  padding: 18rpx 0;
  border-bottom: 1rpx solid #f0f3f1;
  color: #405049;
  line-height: 1.45;
}

.info-row text:first-child {
  flex: 0 0 150rpx;
  color: #7a8580;
}

.info-row text:last-child {
  flex: 1;
  text-align: right;
}

.price {
  color: #ff7a00;
  font-weight: 900;
}

.pricing-info-card {
  margin-top: 28rpx;
  padding: 20rpx;
  border: 1rpx solid #e5eee8;
  border-radius: 20rpx;
  background: #fbfdfc;
}

.pricing-info-card.readonly {
  margin-top: 20rpx;
}

.pricing-copy {
  margin-top: 10rpx;
  color: #6f7b75;
  font-size: 24rpx;
  line-height: 1.6;
}

.review-summary {
  margin-top: 8rpx;
  color: #7a8580;
  font-size: 24rpx;
}

.review-list {
  display: flex;
  flex-direction: column;
  gap: 18rpx;
  margin-top: 20rpx;
}

.review-item {
  padding: 18rpx;
  border: 1rpx solid #edf2ef;
  border-radius: 18rpx;
  background: #fbfdfc;
}

.review-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
}

.review-stars {
  color: #ff8a00;
  font-weight: 900;
}

.review-time,
.review-meta {
  color: #8a9490;
  font-size: 23rpx;
}

.review-meta {
  margin-top: 10rpx;
}

.review-content {
  margin-top: 10rpx;
  color: #405049;
  line-height: 1.55;
}

.review-images {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 12rpx;
  margin-top: 16rpx;
}

.review-image {
  width: 100%;
  aspect-ratio: 1 / 1;
  border-radius: 12rpx;
  background: #f6f8f7;
}
