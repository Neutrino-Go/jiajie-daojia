.page {
  min-height: 100vh;
  padding: 32rpx;
  background: #f7f8fa;
  color: #1f2a24;
}
.header {
  margin-bottom: 24rpx;
}
.title {
  font-size: 36rpx;
  font-weight: 700;
}
.subtitle {
  margin-top: 8rpx;
  color: #6f7a74;
  font-size: 24rpx;
  line-height: 1.5;
}
.panel {
  margin-bottom: 24rpx;
  padding: 24rpx;
  border-radius: 8rpx;
  background: #fff;
}
.section-title {
  margin-bottom: 16rpx;
  font-weight: 600;
}
.row {
  display: flex;
  justify-content: space-between;
  gap: 24rpx;
  padding: 10rpx 0;
  font-size: 26rpx;
}
textarea {
  width: 100%;
  min-height: 160rpx;
  box-sizing: border-box;
  padding: 16rpx;
  border: 1rpx solid #dce3df;
  border-radius: 8rpx;
  background: #fbfcfb;
}
button {
  margin-top: 20rpx;
  background: #16a05d;
  color: #fff;
}
.error {
  color: #c0392b;
  font-size: 24rpx;
}
