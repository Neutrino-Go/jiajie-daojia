<view class="page">
  <view class="section-title">售后与反馈</view>
  <view wx:if="{{loading}}" class="empty">加载中...</view>
  <view wx:for="{{claims}}" wx:key="_id" class="claim-card" data-id="{{item._id}}" bindtap="openClaim">
    <view class="title">{{item.title}}</view>
    <view class="meta">状态：{{item.status}}</view>
    <view class="meta">工单号：{{item.claimNo}}</view>
    <view class="desc">{{item.description}}</view>
  </view>
  <view wx:if="{{!loading && !claims.length}}" class="empty">暂无售后或反馈记录。</view>
</view>
